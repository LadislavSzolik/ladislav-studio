---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DetailSection from "../../components/DetailSection.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const paintings = await getCollection("paintings");
  return paintings.map((painting) => ({
    params: { id: painting.id },
    props: { painting },
  }));
}

const { painting } = Astro.props;
const { Content } = await render(painting);
const pageTitle = painting.data.title;
const isSold = painting.data.isSold;
---

<BaseLayout pageTitle={pageTitle}>
  <main class="main-container">
    <div class="container">
      <div class="detail-container">
        <div class="image-thumbnail-container">
          <!-- Key Image -->
          <div class="key-image-container">
            <img id="mainImage" src={painting.data.keyImage} alt={`Detail of ${painting.data.title}`} />
          </div>
          <!-- Thumbnails -->
          {
            painting.data.detailImages.length > 1 && (
              <div class="thumbnail-gallery">
                {painting.data.detailImages.map((image) => (
                  <button class="thumbnail-button" data-src={image} data-alt={painting.data.title}>
                    <img src={image} alt={`Detail of ${painting.data.title}`} />
                  </button>
                ))}
              </div>
            )
          }
        </div>

        <!-- Details sidebar -->
        <div class="details-sidebar">
          <!-- Title -->
          <div>
            <h1 class="detail-title">{painting.data.title}</h1>
          </div>

          <!-- Price -->
          <div class="price-section">
            <p class="price-label">Price</p>
            <p class="price-value">CHF {painting.data.price}</p>
            {isSold ? 
            <p class="sold">Sold!</p>
            :
            <a
              href=`mailto:ladislav.studio@proton.me?subject=Purchase%20Inquiry:%20${encodeURIComponent(painting.data.title)}`
              class="buy-button"
              title="Purchase Inquiry"
              aria-label="Send email"
            >
              Purchase Inquiry
            </a>
            <p class="price-info">Interested in purchasing? This opens an email inquiry.</p>                        
            }
          </div>

          <!-- Dimensions -->
          <DetailSection label={"Dimensions"} value={painting.data.dimensions} />

          <!-- Medium -->
          <DetailSection label={"Mediums"} value={painting.data.mediums} />

          <!-- Description -->
          <div class="description-box">
            <p class="desc-label">About the painting</p>
            <p class="desc-value"><Content /></p>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
